# Feishu Timesheet Sync Service - Environment Variables Example
# 复制此文件为 .env 并填入实际配置

# Application Environment
APP_ENV=development
DEBUG=true

# Database
DATABASE_URL=sqlite:///./feishu_timesheet.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/feishu_timesheet

# Feishu API Credentials
FEISHU_APP_ID=your_app_id_here
FEISHU_APP_SECRET=your_app_secret_here

# Feishu Multi-dimensional Tables
FEISHU_TIMESHEET_APP_TOKEN=your_timesheet_app_token
FEISHU_TIMESHEET_TABLE_ID=your_timesheet_table_id
FEISHU_PROJECT_CONFIG_APP_TOKEN=your_project_config_app_token
FEISHU_PROJECT_CONFIG_TABLE_ID=your_project_config_table_id

# Website Backend API
WEBSITE_API_BASE_URL=http://localhost:8000/api
WEBSITE_API_KEY=your_website_api_key

# Redis (optional, for caching)
# REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO

# Sync Schedule
SYNC_ENABLED=true
SYNC_CRON="0 2 * * 1"  # Every Monday at 2:00 AM
SYNC_TIMEZONE=Asia/Shanghai

# Standard Hours
STANDARD_HOURS_WEEKLY=40
STANDARD_HOURS_MONTHLY=160
